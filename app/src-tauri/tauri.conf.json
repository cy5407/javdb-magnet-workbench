{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JavDBMagnet",
  "version": "0.3.0",
  "identifier": "com.javdbmagnet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "JavDBMagnet",
        "width": 900,
        "height": 700,
        "minWidth": 700,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "externalBin": ["binaries/sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
