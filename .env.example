# Real-Debrid API Token
# 取得方式：登入後到 https://real-debrid.com/apitoken 複製 token
# 把這個檔案複製為 .env，然後把你的 token 貼到 = 後面
RD_API_TOKEN=

# 自動選擇檔案的策略
# smart   = (推薦) 番號優先 + fallback 過濾：
#           1) 從 magnet 的 dn= 抽出番號（如 SNOS-192），比對 torrent 內影片檔名；
#              番號匹配後仍套 RD_MIN_SIZE_MB 門檻
#           2) 沒有番號匹配時退回單純 size 門檻
#           3) 仍沒有符合條件時退回最大檔
# largest = 只選最大的影片檔（一片一檔時用）
# video   = 所有影片副檔名（不過濾廣告短片）
# all     = 全部選取
RD_FILE_PICK=smart

# smart 策略的最小檔案大小門檻（MB）。低於此值的檔案會被視為廣告/雜訊跳過
RD_MIN_SIZE_MB=500

# 等待快取判定的秒數：選完檔案後等這麼久，
# 還在 downloading 就視為未快取，加到待處理清單繼續下一個磁力
RD_CACHE_WAIT=15

# UI 縮放：auto = 依系統 DPI 自動偵測；或指定倍率如 1.0 / 1.5 / 2.0
# 4K 螢幕在 100% Windows 縮放時建議手動設 1.5 ~ 2.0
UI_SCALE=auto

# UI 主題：light 或 dark
UI_THEME=light
