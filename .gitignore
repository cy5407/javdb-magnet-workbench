pending_torrents.json
logs/
magnet.txt
output/tool-scan/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.coverage
coverage.xml

# PyInstaller 中間檔與打包產出
build/
dist/
release/
*.spec
*.7z

# Cargo isolated target dir used by the release script and standalone
# cargo check runs when the default target/ is locked by a running
# dev server. Never commit these — they can balloon to several GB.
.cargo-check-target/

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Claude Code workspace（僅提交可攜的專案規則與技能）
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/skills/**

# Archify 本機編譯引擎
.archify-engine/

# Archify 產生的圖表（每份約 1.5 萬行內嵌 viewer 程式碼），由同名 *.json 在本機產生，不進 git
/architecture.html
/lifecycle.html
/workflow.html

