    { "id": "e_scraper_to_handle", "from": "javdb_scraper", "to": "handle_mgr", "label": "註冊 Magnet", "variant": "emphasis" },
    { "id": "e_handle_to_triage", "from": "handle_mgr", "to": "rd_triage", "label": "元數據回傳", "variant": "default" },
    { "id": "e_triage_to_rd", "from": "rd_triage", "to": "rd_client", "label": "高優先候選", "variant": "emphasis" },
    { "id": "e_cred_to_rd", "from": "win_cred", "to": "rd_client", "label": "Token 授權", "variant": "security" },
    { "id": "e_rd_to_judge", "from": "rd_client", "to": "cache_judge", "label": "種子狀態", "variant": "default" },
    { "id": "e_judge_to_unrestrict", "from": "cache_judge", "to": "unrestrict_out", "label": "快取秒回", "variant": "emphasis", "role": "return" },
    { "id": "e_judge_to_pending", "from": "cache_judge", "to": "pending_queue", "label": "未快取", "variant": "dashed", "role": "branch" },
    { "id": "e_judge_to_outcome", "from": "cache_judge", "to": "outcome_log", "label": "記錄結果", "variant": "dashed", "role": "branch" },
