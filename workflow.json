    { "id": "rd_client", "lane": "rd", "col": 4, "type": "cloud", "label": "RD API 智慧選檔", "sublabel": "realdebrid.py", "tag": "addMagnet & select", "width": 140 },
    { "id": "cache_judge", "lane": "rd", "col": 5, "type": "database", "label": "快取秒回判定", "sublabel": "100% downloaded 偵測", "tag": "等待秒數控制", "width": 140 },

    { "id": "unrestrict_out", "lane": "ui", "col": 5, "type": "frontend", "label": "HTTPS 直連生成", "sublabel": "一鍵/個別直連複製", "tag": "剪貼簿匯出", "width": 140 },
    { "id": "pending_queue", "lane": "storage", "col": 4, "type": "database", "label": "待處理佇列", "sublabel": "pending_torrents.json", "tag": "重試輪詢", "width": 140 },
    { "id": "outcome_log", "lane": "storage", "col": 5, "type": "database", "label": "成效審計日誌", "sublabel": "rd_outcomes.jsonl", "tag": "8 碼 Hash 脫敏", "width": 140 }
  ],
  "edges": [
